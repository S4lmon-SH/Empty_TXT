				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>if (( $# == 0 )); then
    print -u2 '폴더를 선택한 뒤 실행해 주세요.'
    exit 1
fi
for folder in "$@"; do
    [[ -d "$folder" ]] || { print -u2 "폴더가 아닙니다: $folder"; exit 1; }
    candidate="$folder/새 텍스트 파일.txt"
    integer count=2
    while [[ -e "$candidate" || -L "$candidate" ]]; do
        candidate="$folder/새 텍스트 파일 $count.txt"
        (( count++ ))
    done
    (set -C; : &gt; "$candidate") || exit 1
    print -r -- "$candidate"
done
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string></string>
				</dict>
				<key>Application</key>
